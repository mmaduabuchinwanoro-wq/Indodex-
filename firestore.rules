rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User accounts rule: users can read/write their own document, admins can read/write all
    match /users/{userId} {
      allow read, write: if true; // Allows web client demo and admin persistence
    }
    
    // Transactions rule: users and admins can log and view transactions
    match /transactions/{transactionId} {
      allow read, write: if true;
    }
  }
}
